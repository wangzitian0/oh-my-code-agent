/coverage.out
/dist/
/bin/
*.test
.DS_Store

# Hub runtime state and config. harness.json carries per-tool `env` blocks that
# in practice hold live API tokens, so it must never be committed -- ADR 0003
# and the secret-safe non-functional requirement.
.omca/
# `.claude/` is local agent runtime state and stays ignored -- except the
# skill discovery address. A host reads `<repo>/.claude/skills/`; it does
# not read `<repo>/skills/`, so the committed symlinks there are what makes
# the vendored skills reachable at all (dev_env#120).
# `.claude/*` rather than `.claude/`: git never descends into an ignored
# directory, so a bare `!.claude/skills` under it would match nothing.
.claude/*
!.claude/skills
